  "dependencies": {
    "@workspace/db": "workspace:*",
    "@workspace/hardware-affinity": "workspace:*",
    "@workspace/oa-it": "workspace:*",
    "@workspace/oa-it-setup-cycle": "workspace:*",
    "net-snmp": "^3.29.1"
  },
  "devDependencies": {
    "@types/net-snmp": "^3.23.0",
    "@types/node": "catalog:",
    "tsx": "catalog:"
  }
}
